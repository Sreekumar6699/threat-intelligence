# Local Development Environment Variables
# NEVER push this file to GitHub! Use .env.example as a template.

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=threatdb

# Application Configuration
# Note: For local docker-compose, use 'db' as the hostname. For local python, use 'localhost'.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/threatdb
